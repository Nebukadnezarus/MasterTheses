\@writefile{lof}{\contentsline {figure}{\numberline {7.16}{\ignorespaces Per-motor rotation speeds during hover and straight-line cruise. Key values (per motor): Wing~1 — hover \SI {1200}{rpm}, cruise (9\,m/s) \SI {1150}{rpm}; Wing~2 — hover \SI {1260}{rpm}, cruise (9\,m/s) \SI {1000}{rpm}. The cruise unloading of Wing~2's rotors indicates a larger aerodynamic contribution to lift at forward speed.\relax }}{45}{figure.caption.55}\protected@file@percent }
\newlabel{fig:wing_comparison_motor_speeds}{{7.16}{45}{Per-motor rotation speeds during hover and straight-line cruise. Key values (per motor): Wing~1 — hover \SI {1200}{rpm}, cruise (9\,m/s) \SI {1150}{rpm}; Wing~2 — hover \SI {1260}{rpm}, cruise (9\,m/s) \SI {1000}{rpm}. The cruise unloading of Wing~2's rotors indicates a larger aerodynamic contribution to lift at forward speed.\relax }{figure.caption.55}{}}
